{
  "name": "h3-control",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial Windows desktop control for QCY H3 headphones",
  "author": "Tainan Nery",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "probe": "tsx scripts/probe.ts",
    "dist": "pnpm build && electron-builder --win"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "patchedDependencies": {
      "webbluetooth@7.1.0": "patches/webbluetooth@7.1.0.patch"
    }
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "@tanstack/react-query": "5.104.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "webbluetooth": "7.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
